<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/choose_sport"
            android:textColor="#21005D"
            android:textSize="22sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_search_sports"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_search_bar"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="12dp"
            android:hint="@string/search_sports_hint"
            android:inputType="text"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:textColor="#21005D"
            android:textColorHint="#79747E"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btn_football"
            style="@style/SportButton"
            android:text="@string/football"
            app:icon="@drawable/ic_football" />

        <Button
            android:id="@+id/btn_basketball"
            style="@style/SportButton"
            android:text="@string/basketball"
            app:icon="@drawable/ic_basketball" />

        <Button
            android:id="@+id/btn_tennis"
            style="@style/SportButton"
            android:text="@string/tennis"
            app:icon="@drawable/ic_tennis" />

        <Button
            android:id="@+id/btn_swimming"
            style="@style/SportButton"
            android:text="@string/swimming"
            app:icon="@drawable/ic_swimming" />

        <Button
            android:id="@+id/btn_running"
            style="@style/SportButton"
            android:text="@string/running"
            app:icon="@drawable/ic_running" />

        <TextView
            android:id="@+id/tv_no_sports"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="@string/no_sports_found"
            android:textColor="#79747E"
            android:textSize="16sp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
