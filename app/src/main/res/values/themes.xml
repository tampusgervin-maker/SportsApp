<resources>
    <style name="Theme.SportsApp" parent="Theme.Material3.Light">
        <item name="colorPrimary">#6200EE</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#E9DDFF</item>
        <item name="colorOnPrimaryContainer">#21005D</item>
        <item name="colorSecondaryContainer">#E9DDFF</item>
        <item name="colorOnSecondaryContainer">#21005D</item>
        <item name="android:statusBarColor">#3700B3</item>
